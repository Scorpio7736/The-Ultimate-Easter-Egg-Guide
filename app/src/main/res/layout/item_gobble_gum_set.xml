<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#44000000"
    app:cardCornerRadius="12dp"
    app:strokeColor="#44FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/set_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nz_font"
            android:text="Set Name"
            android:textColor="@color/accent_gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/map_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Map Name"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:alpha="0.8" />

        <include
            android:id="@+id/gum_set_bar"
            layout="@layout/gobble_gum_set_bar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
